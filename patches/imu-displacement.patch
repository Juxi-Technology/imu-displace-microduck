+//! Capture the module's attitude in poses the operator declares.
+//!
+//! ## What a mount is, and why this cannot be finished on a bare bench
+//!
+//! The mount is the rotation that carries the module's frame to the trunk's. It is a fact
+//! about **how the module is bolted to the trunk**, so it cannot be measured from the module
+//! alone: with no trunk there is nothing for the rotation to be relative to, and a bench run
+//! can only say what the module's own axes are.
+//!
+//! What this tool does now is the part that *is* available before the trunk exists — capture
+//! the module's frame cleanly, in whatever orientation the operator holds it, with a check
+//! that the module did not move during the window. Mounted later, the same capture in the
+//! robot's standing pose plus a declaration of which module axis points forward is the whole
+//! of the mount.
+//!
+//! ```text
+//! cargo run -p duck-control --example imu_mount                      # live, 2 Hz
+//! cargo run -p duck-control --example imu_mount -- --capture level   # average 5 s, save
+//! cargo run -p duck-control --example imu_mount -- /dev/i2c-7 --capture tilt-x --seconds 8
+//! ```
+//!
+//! ## Reading the live output
+//!
+//! ```text
+//! gravity   +0.016 -0.010 -1.000        |q| 1.0000
+//!             ^      ^      ^
+//!           module module module
+//!             X      Y      Z
+//! ```
+//!
+//! Gravity is the world's **down** expressed in the module's frame — `ImuData` documents
+//! upright as `[0, 0, -1]` — so the vector names the module axis that points down. Held flat
+//! with the component side up it reads near `+0.0 +0.0 −1.0`, meaning the module's `−Z` is
+//! down and its `+Z` is the component-side normal. Measured 2026-10-15.
+//!
+//! ## Why a capture is averaged rather than sampled once
+//!
+//! One sample carries the gyro's noise and the module's own fusion wobble. An average over a
+//! few seconds does not, and the deviation from that average is the number that says whether
+//! the operator's hand was steady enough for the result to mean anything — a capture that
+//! moved is worse than no capture, because it looks like data.
+
+#[cfg(not(target_os = "linux"))]
+fn main() {
+    eprintln!("The IMU module is reached through /dev/i2c-*, which exists only on Linux.");
+    eprintln!("Run this on the robot, or on any Linux board with the module attached.");
+    std::process::exit(2);
+}
+
+#[cfg(target_os = "linux")]
+fn main() {
+    mount::run();
+}
+
+#[cfg(target_os = "linux")]
+mod mount {
+    use std::io::Write as _;
+    use std::path::PathBuf;
+    use std::time::{Duration, Instant};
+
+    use duck_control::imu_i2c::{Icm42670pI2c, RegisterBlocks, open_first};
+    use duck_control::imu_icm42670p::{GYRO_RAD_PER_LSB, Icm42670pDecoder, Icm42670pSample};
+
+    /// Faster than the control loop, because a capture averages anyway and a pose the operator
+    /// is holding by hand drifts.
+    const RATE_HZ: u64 = 100;
+    const PERIOD: Duration = Duration::from_micros(1_000_000 / RATE_HZ);
+
+    /// Live readout cadence. A human is watching, not a log.
+    const PRINT_EVERY: u64 = 50;
+
+    const UNROTATED: [f64; 4] = [1.0, 0.0, 0.0, 0.0];
+
+    /// A capture whose deviation from its own mean exceeds this moved, and is not a pose.
+    /// Sized from the module's own noise: a still module's gravity wanders by a few
+    /// thousandths, so a tenth is well clear of it and still catches a real movement.
+    const STEADY_TOLERANCE: f64 = 0.1;
+
+    pub fn run() {
+        let mut bus: Option<PathBuf> = None;
+        let mut label: Option<String> = None;
+        let mut seconds = 5.0f64;
+        let mut settle = 3.0f64;
+        let mut file: Option<PathBuf> = None;
+
+        let mut args = std::env::args().skip(1);
+        while let Some(arg) = args.next() {
+            match arg.as_str() {
+                "--capture" => {
+                    label = Some(
+                        args.next()
+                            .unwrap_or_else(|| die("--capture wants a label")),
+                    )
+                }
+                "--seconds" => {
+                    seconds = args
+                        .next()
+                        .and_then(|v| v.parse().ok())
+                        .unwrap_or_else(|| die("--seconds wants a number"));
+                }
+                "--settle" => {
+                    settle = args
+                        .next()
+                        .and_then(|v| v.parse().ok())
+                        .unwrap_or_else(|| die("--settle wants a number"));
+                }
+                "--file" => {
+                    file = Some(PathBuf::from(
+                        args.next().unwrap_or_else(|| die("--file wants a path")),
+                    ))
+                }
+                other => match other.parse::<f64>() {
+                    Ok(secs) => seconds = secs,
+                    Err(_) => bus = Some(PathBuf::from(other)),
+                },
+            }
+        }
+
+        let module = match open_first(bus.as_deref()) {
+            Ok(module) => module,
+            Err(e) => {
+                eprintln!("no module: {e}");
+                eprintln!(
+                    "checked: {}",
+                    duck_control::imu_i2c::BUS_CANDIDATES.join(", ")
+                );
+                std::process::exit(1);
+            }
+        };
+        let mut decoder = Icm42670pDecoder::new(UNROTATED);
+
+        match label {
+            Some(label) => capture(module, &mut decoder, &label, seconds, settle, file),
+            None => live(module, &mut decoder, seconds),
+        }
+    }
+
+    fn die(message: &str) -> ! {
+        eprintln!("{message}");
+        std::process::exit(2);
+    }
+
+    fn sample_or_warn<B: RegisterBlocks>(module: &mut Icm42670pI2c<B>) -> Option<Icm42670pSample> {
+        match module.read_sample() {
+            Ok(sample) => Some(sample),
+            Err(e) => {
+                eprintln!("read failed: {e}");
+                None
+            }
+        }
+    }
+
+    /// Show the attitude as it comes, so a human can watch the effect of moving the module.
+    fn live<B: RegisterBlocks>(
+        mut module: Icm42670pI2c<B>,
+        decoder: &mut Icm42670pDecoder,
+        seconds: f64,
+    ) {
+        println!("live, {RATE_HZ} Hz for {seconds:.0} s — module axes, no mount applied");
+        println!("gravity points up in the module's frame; |q| should sit near 1");
+        println!();
+
+        let deadline = Instant::now() + Duration::from_secs_f64(seconds);
+        let mut ticks = 0u64;
+        while Instant::now() < deadline {
+            let tick = Instant::now();
+            if let Some(sample) = sample_or_warn(&mut module) {
+                ticks += 1;
+                if ticks.is_multiple_of(PRINT_EVERY) {
+                    let imu = decoder.decode(&sample);
+                    let norm = imu.quat.iter().map(|c| c * c).sum::<f64>().sqrt();
+                    println!(
+                        "gravity   {:+.3} {:+.3} {:+.3}        |q| {norm:.4}   gyro {:+.2} {:+.2} {:+.2}",
+                        imu.gravity[0],
+                        imu.gravity[1],
+                        imu.gravity[2],
+                        sample.gyro[0] as f64 * GYRO_RAD_PER_LSB,
+                        sample.gyro[1] as f64 * GYRO_RAD_PER_LSB,
+                        sample.gyro[2] as f64 * GYRO_RAD_PER_LSB,
+                    );
+                }
+            }
+            pace(tick);
+        }
+    }
+
+    /// Average one pose and record it.
+    fn capture<B: RegisterBlocks>(
+        mut module: Icm42670pI2c<B>,
+        decoder: &mut Icm42670pDecoder,
+        label: &str,
+        seconds: f64,
+        settle: f64,
+        file: Option<PathBuf>,
+    ) {
+        println!(
+            "capturing '{label}': {settle:.0} s to get into position, then {seconds:.0} s held."
+        );
+        println!();
+
+        // The operator starts the run and only then has their hands where they want them — so
+        // the reach into the pose is discarded rather than averaged in. Without this, a capture
+        // taken while the module was still being placed reads as one that moved, which is
+        // indistinguishable from a hand that shook.
+        let deadline = Instant::now() + Duration::from_secs_f64(settle + seconds);
+        let settled_at = Instant::now() + Duration::from_secs_f64(settle);
+        let mut quats: Vec<[f64; 4]> = Vec::new();
+        let mut gravity: Vec<[f64; 3]> = Vec::new();
+        let mut failures = 0u64;
+
+        while Instant::now() < deadline {
+            let tick = Instant::now();
+            match module.read_sample() {
+                Ok(sample) => {
+                    // Decoded on every sample, including the settle, and only *recorded* after
+                    // it. Skipping the decode during the settle would leave the decoder's
+                    // histories cold, and its first output is then the initial state rather
+                    // than a measurement — one sample at right angles to the pose, which the
+                    // spread check reads as a hand that moved. It cost four captures to find,
+                    // and only because the pose held happened to differ from upright.
+                    let imu = decoder.decode(&sample);
+                    if Instant::now() >= settled_at {
+                        quats.push(imu.quat);
+                        gravity.push(imu.gravity);
+                    }
+                }
+                Err(e) => {
+                    failures += 1;
+                    if failures <= 3 {
+                        eprintln!("read failed: {e}");
+                    }
+                }
+            }
+            pace(tick);
+        }
+
+        if gravity.len() < 10 {
+            die("too few samples to average — is the module answering?");
+        }
+
+        let mean_quat = mean_quaternion(&quats);
+        let mean_gravity = mean_vector(&gravity);
+        let spread = gravity
+            .iter()
+            .map(|g| distance(*g, mean_gravity))
+            .fold(0.0f64, f64::max);
+        let norm = mean_quat.iter().map(|c| c * c).sum::<f64>().sqrt();
+
+        println!(
+            "captured '{label}': {} samples over {seconds:.0} s, {failures} read failures",
+            gravity.len()
+        );
+        println!(
+            "  quaternion  w {:+.4}  x {:+.4}  y {:+.4}  z {:+.4}   |q| {norm:.4}",
+            mean_quat[0], mean_quat[1], mean_quat[2], mean_quat[3]
+        );
+        println!(
+            "  gravity     {:+.4} {:+.4} {:+.4}",
+            mean_gravity[0], mean_gravity[1], mean_gravity[2]
+        );
+        println!("  spread      {spread:.4}  (max deviation over the window)");
+
+        if spread > STEADY_TOLERANCE {
+            println!();
+            println!("  !! the module moved during the window — this is not one pose.");
+            println!("     Nothing was saved: a pose that moved is worse than no pose, because");
+            println!("     it looks like data and a solver downstream cannot tell.");
+            println!("     Hold it still and run the same capture again.");
+            std::process::exit(1);
+        }
+
+        let path = file.unwrap_or_else(default_capture_file);
+        match append_capture(&path, label, mean_quat, mean_gravity, spread) {
+            Ok(()) => println!("  appended to {}", path.display()),
+            Err(e) => {
+                eprintln!("  could not write {}: {e}", path.display());
+                std::process::exit(1);
+            }
+        }
+
+        println!();
+        println!("The mount still needs a trunk. Mounted, capture the robot's standing pose as");
+        println!("'level' and declare which module axis points forward; that plus the robot");
+        println!("rotated 90° about each trunk axis is the whole of it.");
+    }
+
+    fn default_capture_file() -> PathBuf {
+        match std::env::var_os("HOME") {
+            Some(home) => PathBuf::from(home).join("imu-mount.txt"),
+            None => PathBuf::from("imu-mount.txt"),
+        }
+    }
+
+    /// One line per capture, human-readable and easy to hand-edit. Not a format anything
+    /// parses yet — a solver that reads it will pin it then, and until there is a trunk there
+    /// is nothing to solve.
+    fn append_capture(
+        path: &PathBuf,
+        label: &str,
+        quat: [f64; 4],
+        gravity: [f64; 3],
+        spread: f64,
+    ) -> std::io::Result<()> {
+        let mut file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)?;
+        writeln!(
+            file,
+            "{label}\tquat {:.6} {:.6} {:.6} {:.6}\tgravity {:.6} {:.6} {:.6}\tspread {spread:.6}",
+            quat[0], quat[1], quat[2], quat[3], gravity[0], gravity[1], gravity[2]
+        )
+    }
+
+    /// Averaged with the sign ambiguity removed.
+    ///
+    /// `q` and `−q` are the same rotation, so a module sitting exactly on the boundary between
+    /// them would average to zero — and the boundary is not exotic, it is wherever the fused
+    /// yaw happens to cross. Each sample is therefore flipped into the first sample's
+    /// hemisphere before it is summed.
+    fn mean_quaternion(samples: &[[f64; 4]]) -> [f64; 4] {
+        let reference = samples[0];
+        let mut sum = [0.0f64; 4];
+        for q in samples {
+            let dot: f64 = (0..4).map(|i| q[i] * reference[i]).sum();
+            let sign = if dot < 0.0 { -1.0 } else { 1.0 };
+            for i in 0..4 {
+                sum[i] += sign * q[i];
+            }
+        }
+        let norm = sum.iter().map(|c| c * c).sum::<f64>().sqrt();
+        if norm <= 0.0 {
+            return reference;
+        }
+        [sum[0] / norm, sum[1] / norm, sum[2] / norm, sum[3] / norm]
+    }
+
+    fn mean_vector(samples: &[[f64; 3]]) -> [f64; 3] {
+        let mut sum = [0.0f64; 3];
+        for v in samples {
+            for i in 0..3 {
+                sum[i] += v[i];
+            }
+        }
+        let n = samples.len() as f64;
+        [sum[0] / n, sum[1] / n, sum[2] / n]
+    }
+
+    fn distance(a: [f64; 3], b: [f64; 3]) -> f64 {
+        (0..3).map(|i| (a[i] - b[i]).powi(2)).sum::<f64>().sqrt()
+    }
+
+    fn pace(tick: Instant) {
+        let spent = tick.elapsed();
+        if spent < PERIOD {
+            std::thread::sleep(PERIOD - spent);
+        }
+    }
+}
diff --git a/duck-control/examples/imu_probe.rs b/duck-control/examples/imu_probe.rs
new file mode 100644
index 0000000..c3b7861
--- /dev/null
+++ b/duck-control/examples/imu_probe.rs
@@ -0,0 +1,258 @@
+//! Read the external IMU module off its I²C bus and report whether it is fit to run a robot.
+//!
+//! This is the bench tool for the swap, and the only step that needs hardware at all — and it
+//! needs *only* the module. No servos, no assembled robot. Run it before wiring anything else.
+//!
+//! ```text
+//! cargo run -p duck-control --example imu_probe             # find the module, read for 20 s
+//! cargo run -p duck-control --example imu_probe -- /dev/i2c-3 30
+//! ```
+//!
+//! It answers, in the order that would stop you:
+//!
+//! * does the module answer, and on which bus
+//! * is it producing samples at the rate the control loop needs — 50 Hz, and the module does 100
+//! * are the samples *new*. A module repeating one frame looks fast and is not, which is why
+//!   the new-value rate is reported next to the sample rate rather than instead of it
+//! * does the decoded attitude make sense: gravity is a unit vector near −Z when the module is
+//!   level, and the gyro sits near zero when it is still — except that this module's stillness
+//!   gate zeroes it *exactly*, which is a property, not a fault
+//! * what a sample costs on the bus, which is the number that decides whether this can share a
+//!   tick with the servos
+//!
+//! It does **not** calibrate the mount, and cannot: the mount is a fact about how the module is
+//! bolted to the trunk, not about the bus. Until that is measured this reports attitude in the
+//! module's own axes, so a level module need not read as level.
+
+#[cfg(not(target_os = "linux"))]
+fn main() {
+    eprintln!("The IMU module is reached through /dev/i2c-*, which exists only on Linux.");
+    eprintln!("Run this on the robot, or on any Linux board with the module attached.");
+    std::process::exit(2);
+}
+
+#[cfg(target_os = "linux")]
+fn main() {
+    probe::run();
+}
+
+#[cfg(target_os = "linux")]
+mod probe {
+    use std::path::PathBuf;
+    use std::time::{Duration, Instant};
+
+    use duck_control::imu_i2c::{ADDRESS, Icm42670pI2c, RegisterBlocks, open_first};
+    use duck_control::imu_icm42670p::{GYRO_RAD_PER_LSB, Icm42670pDecoder, Icm42670pSample};
+
+    /// The module fuses at 100 Hz; pacing the reads to that is what the robot will do, so the
+    /// probe measures the same thing the robot will live with rather than hammering the bus.
+    const RATE_HZ: u64 = 100;
+    const PERIOD: Duration = Duration::from_micros(1_000_000 / RATE_HZ);
+
+    /// Without a mount there is no rotation to apply, and inventing one would make the report
+    /// agree with a robot that does not exist.
+    const UNROTATED: [f64; 4] = [1.0, 0.0, 0.0, 0.0];
+
+    pub fn run() {
+        let mut bus: Option<PathBuf> = None;
+        let mut seconds = 20.0f64;
+        for arg in std::env::args().skip(1) {
+            match arg.parse::<f64>() {
+                Ok(secs) => seconds = secs,
+                Err(_) => bus = Some(PathBuf::from(arg)),
+            }
+        }
+
+        let module = match open_first(bus.as_deref()) {
+            Ok(module) => module,
+            Err(e) => {
+                eprintln!("no module: {e}");
+                eprintln!(
+                    "checked: {}",
+                    duck_control::imu_i2c::BUS_CANDIDATES.join(", ")
+                );
+                eprintln!();
+                eprintln!("Find the bus rather than guessing it — the numbering is per board:");
+                eprintln!(
+                    "  i2cdetect -l                 which buses exist, and what they are called"
+                );
+                eprintln!("  sudo i2cdetect -y -r N       should show {ADDRESS:#04x}");
+                eprintln!("then name it:");
+                eprintln!("  cargo run -p duck-control --example imu_probe -- /dev/i2c-N 20");
+                eprintln!();
+                eprintln!("Opening /dev/i2c-* needs root or the `i2c` group, and the bus only");
+                eprintln!(
+                    "exists once I²C is enabled — raspi-config on a Pi, jetson-io on a Jetson."
+                );
+                std::process::exit(1);
+            }
+        };
+
+        println!("reading for {seconds:.0} s at {RATE_HZ} Hz...");
+        let report = measure(module, Duration::from_secs_f64(seconds));
+        report.print();
+        if !report.passes() {
+            std::process::exit(1);
+        }
+    }
+
+    struct Report {
+        seconds: f64,
+        samples: u64,
+        fresh: u64,
+        failures: u64,
+        rejected: u64,
+        bus_nanos: u128,
+        ready_after: Option<u64>,
+        last: Option<(Icm42670pSample, f64, [f64; 3])>,
+    }
+
+    impl Report {
+        fn sample_hz(&self) -> f64 {
+            self.samples as f64 / self.seconds
+        }
+
+        /// How often the whole frame changed, which is not the same as how often the module
+        /// produced something. Gyro noise makes every frame differ, so this sits at 100% by
+        /// construction and only moves when a frame is frozen *entire* — the failure it is here
+        /// to catch. Whether the quaternions inside those frames are usable is
+        /// [`Self::rejected`]'s question, and this number cannot answer it.
+        fn fresh_hz(&self) -> f64 {
+            self.fresh as f64 / self.seconds
+        }
+
+        /// What one sample costs on the bus — the share of a 20 ms tick it would claim.
+        fn bus_ms(&self) -> f64 {
+            if self.samples == 0 {
+                return 0.0;
+            }
+            self.bus_nanos as f64 / self.samples as f64 / 1e6
+        }
+
+        fn passes(&self) -> bool {
+            self.failures == 0 && self.fresh_hz() >= 45.0 && self.ready_after.is_some()
+        }
+
+        fn print(&self) {
+            println!();
+            println!(
+                "samples        {:>6}   {:.1} Hz",
+                self.samples,
+                self.sample_hz()
+            );
+            println!(
+                "frame changes  {:>6}   {:.1} Hz   (catches a frozen frame, nothing subtler)",
+                self.fresh,
+                self.fresh_hz()
+            );
+            println!("read failures  {:>6}", self.failures);
+            println!(
+                "rejected quats {:>6}{}",
+                self.rejected,
+                if self.rejected == 0 {
+                    String::new()
+                } else {
+                    format!(
+                        "   <- {:.2}% of samples held the previous attitude",
+                        100.0 * self.rejected as f64 / self.samples.max(1) as f64
+                    )
+                }
+            );
+            println!("bus time       {:>6.2} ms per sample", self.bus_ms());
+            match self.ready_after {
+                Some(n) => println!("ready after    {n:>6} samples"),
+                None => {
+                    println!("ready after         -   the module never produced 25 quaternions")
+                }
+            }
+            if let Some((raw, norm, gravity)) = self.last {
+                println!();
+                println!(
+                    "last gyro      {:+.3} {:+.3} {:+.3} rad/s   (module axes, unrotated)",
+                    raw.gyro[0] as f64 * GYRO_RAD_PER_LSB,
+                    raw.gyro[1] as f64 * GYRO_RAD_PER_LSB,
+                    raw.gyro[2] as f64 * GYRO_RAD_PER_LSB,
+                );
+                println!(
+                    "last gravity   {:+.3} {:+.3} {:+.3}   |q| = {norm:.4}",
+                    gravity[0], gravity[1], gravity[2]
+                );
+            }
+
+            println!();
+            if self.passes() {
+                println!("PASS — the module is fit to wire into robotd.");
+                println!(
+                    "Next: measure the mount. Three poses (level, +90° about X, +90° about Y),"
+                );
+                println!("and the quaternion that carries one to the other is the mount constant.");
+            } else if self.fresh_hz() < 45.0 {
+                println!("FAIL — the module is repeating whole frames.");
+                println!(
+                    "A frozen frame is what a module whose output rate was never raised looks"
+                );
+                println!("like from here: set it over the serial link and measure again.");
+            } else if self.failures > 0 {
+                println!(
+                    "FAIL — the bus dropped reads. Check wiring and pull-ups before anything else."
+                );
+            } else {
+                println!("FAIL — the module never produced a usable quaternion.");
+            }
+        }
+    }
+
+    fn measure<B: RegisterBlocks>(mut module: Icm42670pI2c<B>, window: Duration) -> Report {
+        let mut decoder = Icm42670pDecoder::new(UNROTATED);
+        let mut report = Report {
+            seconds: 0.0,
+            samples: 0,
+            fresh: 0,
+            failures: 0,
+            rejected: 0,
+            bus_nanos: 0,
+            ready_after: None,
+            last: None,
+        };
+        let mut previous: Option<Icm42670pSample> = None;
+
+        let start = Instant::now();
+        let deadline = start + window;
+        while Instant::now() < deadline {
+            let tick = Instant::now();
+            match module.read_sample() {
+                Ok(sample) => {
+                    report.bus_nanos += tick.elapsed().as_nanos();
+                    report.samples += 1;
+                    if previous != Some(sample) {
+                        report.fresh += 1;
+                    }
+                    previous = Some(sample);
+                    let decoded = decoder.decode(&sample);
+                    if report.ready_after.is_none() && decoder.ready() {
+                        report.ready_after = Some(report.samples);
+                    }
+                    let norm = decoded.quat.iter().map(|c| c * c).sum::<f64>().sqrt();
+                    report.last = Some((sample, norm, decoded.gravity));
+                }
+                Err(e) => {
+                    report.failures += 1;
+                    // Say it the first few times and then stop: a module that is unplugged
+                    // would otherwise fill the terminal with the same line.
+                    if report.failures <= 3 {
+                        eprintln!("read failed: {e}");
+                    }
+                }
+            }
+            let spent = tick.elapsed();
+            if spent < PERIOD {
+                std::thread::sleep(PERIOD - spent);
+            }
+        }
+        report.seconds = start.elapsed().as_secs_f64();
+        // Every successful read was decoded once, so the gap between the reads and the
+        // quaternions the decoder kept is exactly the ones it refused.
+        report.rejected = report.samples - u64::from(decoder.quat_samples());
+        report
+    }
+}
diff --git a/duck-control/examples/imu_to_observation.rs b/duck-control/examples/imu_to_observation.rs
new file mode 100644
index 0000000..3e8191e
--- /dev/null
+++ b/duck-control/examples/imu_to_observation.rs
@@ -0,0 +1,368 @@
+//! Drive the real IMU through the [`RobotIo`] seam and out the other side as the policy's
+//! observation.
+//!
+//! This is the third step's instrument. The transport is already proven on its own by
+//! `imu_probe`; what that cannot say is whether the six numbers the policy takes from the IMU
+//! arrive in the right slots. `obs.rs` calls itself "the highest-risk code in the crate"
+//! because a wrong index does not fail loudly — it produces a plausible robot that falls over.
+//! So this reads the real module every tick, builds the real observation through the real
+//! entry point, and checks the two things that would be silently wrong:
+//!
+//! * **`obs[0..3]` is the gyro and `obs[3..6]` is the projected gravity**, compared against
+//!   the `ImuData` that went in. Anything else and the policy is being lied to.
+//! * **the joint blocks are zero**, because the fake joints report the home pose and the
+//!   policy sees positions *relative* to it. A non-zero here means the home pose and the
+//!   backend disagree, which is a constant offset on fourteen slots.
+//!
+//! ```text
+//! cargo run -p duck-control --example imu_to_observation             # find the module, 20 s
+//! cargo run -p duck-control --example imu_to_observation -- /dev/i2c-7 60
+//! ```
+//!
+//! ## What this does not prove
+//!
+//! The joints are fake, so nothing here says anything about the servo bus, and the mount is
+//! uncalibrated, so the attitude is in the module's own axes rather than the trunk's. Both are
+//! stated in the output rather than left to be discovered. What it does prove is that a real
+//! IMU survives the whole path from `/dev/i2c-*` to the exact slots the policy reads — which
+//! leaves only the bus half for the day the servos arrive.
+//!
+//! ## What the bench backend is not
+//!
+//! `slow_sensors` reports zeros. There are no servos to ask, and the trait has no way to say
+//! "not measured" — only `measures_velocity` and `measures_load` carry that distinction, and
+//! a supply voltage has no equivalent. A consumer watching the battery would read 0 V, which
+//! is exactly what this is: a bench, not a robot.
+
+#[cfg(not(target_os = "linux"))]
+fn main() {
+    eprintln!("The IMU module is reached through /dev/i2c-*, which exists only on Linux.");
+    eprintln!("Run this on the robot, or on any Linux board with the module attached.");
+    std::process::exit(2);
+}
+
+#[cfg(target_os = "linux")]
+fn main() {
+    bench::run();
+}
+
+#[cfg(target_os = "linux")]
+mod bench {
+    use std::path::PathBuf;
+    use std::time::{Duration, Instant};
+
+    use duck_control::imu_i2c::{Icm42670pI2c, RegisterBlocks, open_first};
+    use duck_control::imu_icm42670p::Icm42670pDecoder;
+    use duck_control::io::{IoError, JointTargets, RobotIo, Sensors, SlowSensors};
+    use duck_control::{ACTION_LEN, Command, DEFAULT_POSITION, NUM_JOINTS, Observation};
+
+    /// The control loop's rate, so the tick budget this exercises is the robot's.
+    const RATE_HZ: u64 = 50;
+    const PERIOD: Duration = Duration::from_micros(1_000_000 / RATE_HZ);
+
+    /// Print this often. At 50 Hz a line per tick buries the reading that matters.
+    const PRINT_EVERY: u64 = 25;
+
+    /// Without a mount there is no rotation to apply, and inventing one would make the output
+    /// agree with a robot that does not exist.
+    const UNROTATED: [f64; 4] = [1.0, 0.0, 0.0, 0.0];
+
+    pub fn run() {
+        let mut bus: Option<PathBuf> = None;
+        let mut seconds = 20.0f64;
+        for arg in std::env::args().skip(1) {
+            match arg.parse::<f64>() {
+                Ok(secs) => seconds = secs,
+                Err(_) => bus = Some(PathBuf::from(arg)),
+            }
+        }
+
+        let module = match open_first(bus.as_deref()) {
+            Ok(module) => module,
+            Err(e) => {
+                eprintln!("no module: {e}");
+                eprintln!(
+                    "checked: {}",
+                    duck_control::imu_i2c::BUS_CANDIDATES.join(", ")
+                );
+                eprintln!("`i2cdetect -l` lists the buses; pass the one the module is on.");
+                std::process::exit(1);
+            }
+        };
+
+        println!(
+            "{} Hz for {seconds:.0} s — fake joints at the home pose, real IMU, uncalibrated mount",
+            RATE_HZ
+        );
+        println!("attitude below is in the module's own axes until the mount is measured.");
+        println!();
+
+        let io = ImuOnlyIo::new(module, UNROTATED);
+        let report = drive(io, Duration::from_secs_f64(seconds));
+        report.print();
+        if !report.passed() {
+            std::process::exit(1);
+        }
+    }
+
+    /// Servos that hold the home pose and a real IMU.
+    ///
+    /// Generic over the register transport rather than over `/dev/i2c-*`, so the joint half and
+    /// the wiring to [`Sensors`] can be exercised with a fake bus — the same split that lets
+    /// the decode be tested without a module.
+    struct ImuOnlyIo<B: RegisterBlocks> {
+        module: Icm42670pI2c<B>,
+        decoder: Icm42670pDecoder,
+        /// Where the fake joints are held. The observation subtracts the home pose from this,
+        /// so holding it *at* home is what makes the joint blocks zero.
+        pose: [f64; NUM_JOINTS],
+    }
+
+    impl<B: RegisterBlocks> ImuOnlyIo<B> {
+        fn new(module: Icm42670pI2c<B>, mount: [f64; 4]) -> Self {
+            Self {
+                module,
+                decoder: Icm42670pDecoder::new(mount),
+                pose: DEFAULT_POSITION,
+            }
+        }
+    }
+
+    impl<B: RegisterBlocks> RobotIo for ImuOnlyIo<B> {
+        fn read(&mut self) -> duck_control::io::Result<Sensors> {
+            let sample = self
+                .module
+                .read_sample()
+                .map_err(|e| IoError::Bus(format!("imu: {e}")))?;
+            Ok(Sensors {
+                positions: self.pose,
+                velocities: [0.0; NUM_JOINTS],
+                currents_ma: [0.0; NUM_JOINTS],
+                imu: self.decoder.decode(&sample),
+            })
+        }
+
+        // A bench has nothing to drive. Each of these says so rather than pretending.
+        fn write(&mut self, _targets: &JointTargets) -> duck_control::io::Result<()> {
+            Ok(())
+        }
+        fn set_gain(&mut self, _kp: u16) -> duck_control::io::Result<()> {
+            Ok(())
+        }
+        fn set_torque(&mut self, _on: bool) -> duck_control::io::Result<()> {
+            Ok(())
+        }
+        fn reboot(&mut self, _id: u8) -> duck_control::io::Result<()> {
+            Ok(())
+        }
+        fn slow_sensors(&mut self) -> duck_control::io::Result<SlowSensors> {
+            Ok(SlowSensors {
+                volts: 0.0,
+                temps_c: [0.0; NUM_JOINTS],
+            })
+        }
+
+        // The two declarations that stop zeros being read as measurements: these joints are
+        // not moving and nothing is measuring their current, and saying so is the difference
+        // between "still" and "unmeasured".
+        fn measures_velocity(&self) -> bool {
+            false
+        }
+        fn measures_load(&self) -> bool {
+            false
+        }
+
+        fn imu_ready(&self) -> bool {
+            self.decoder.ready()
+        }
+    }
+
+    struct Report {
+        seconds: f64,
+        ticks: u64,
+        read_failures: u64,
+        stale_ticks: u64,
+        bad_gyro: u64,
+        bad_gravity: u64,
+        bad_joints: u64,
+        ready_after: Option<u64>,
+        last_gyro: [f64; 3],
+        last_gravity: [f64; 3],
+        last_norm: f64,
+    }
+
+    impl Report {
+        fn passed(&self) -> bool {
+            // Nothing is allowed to be wrong that the robot would not notice. A rejection is
+            // not a failure — the decoder is supposed to hold through one — but a wrong slot
+            // or a non-zero joint block is exactly the silent corruption this run exists to
+            // catch, so one of those is a red result however few there are.
+            self.ticks > 0
+                && self.read_failures == 0
+                && self.bad_gyro == 0
+                && self.bad_gravity == 0
+                && self.bad_joints == 0
+                && self.ready_after.is_some()
+        }
+
+        fn print(&self) {
+            println!();
+            println!(
+                "ticks          {:>6}   {:.1} Hz",
+                self.ticks,
+                self.ticks as f64 / self.seconds
+            );
+            println!("read failures  {:>6}", self.read_failures);
+            println!(
+                "stale ticks    {:>6}{}",
+                self.stale_ticks,
+                if self.stale_ticks == 0 {
+                    String::new()
+                } else {
+                    format!(
+                        "   ({:.2}% held the previous attitude)",
+                        100.0 * self.stale_ticks as f64 / self.ticks.max(1) as f64
+                    )
+                }
+            );
+            println!(
+                "last gyro      {:+.3} {:+.3} {:+.3} rad/s   (module axes, unrotated)",
+                self.last_gyro[0], self.last_gyro[1], self.last_gyro[2]
+            );
+            println!(
+                "last gravity   {:+.3} {:+.3} {:+.3}   |q| = {:.4}",
+                self.last_gravity[0], self.last_gravity[1], self.last_gravity[2], self.last_norm
+            );
+            match self.ready_after {
+                Some(n) => println!("ready after    {n:>6} ticks"),
+                None => println!("ready after         -   never converged"),
+            }
+
+            println!();
+            println!("observation slot checks");
+            println!("  obs[0..3]   gyro        {} mismatch(es)", self.bad_gyro);
+            println!(
+                "  obs[3..6]   gravity     {} mismatch(es)",
+                self.bad_gravity
+            );
+            println!(
+                "  obs[6..34]  joints      {} non-zero (want 0)",
+                self.bad_joints
+            );
+
+            println!();
+            if self.passed() {
+                println!("PASS — a real IMU reaches the policy's slots intact.");
+                println!("Only the servo bus is left unproven, and it is not on this bench.");
+            } else if self.bad_gyro > 0 || self.bad_gravity > 0 {
+                println!("FAIL — the observation disagrees with the IMU. The layout is wrong;");
+                println!("       do not trust anything downstream of it.");
+            } else if self.bad_joints > 0 {
+                println!("FAIL — the joint block is not zero though the joints are at home.");
+            } else if self.read_failures > 0 {
+                println!("FAIL — the bus dropped reads.");
+            } else {
+                println!("FAIL — the orientation never converged.");
+            }
+        }
+    }
+
+    fn drive<B: RegisterBlocks>(mut io: ImuOnlyIo<B>, window: Duration) -> Report {
+        let mut report = Report {
+            seconds: 0.0,
+            ticks: 0,
+            read_failures: 0,
+            stale_ticks: 0,
+            bad_gyro: 0,
+            bad_gravity: 0,
+            bad_joints: 0,
+            ready_after: None,
+            last_gyro: [0.0; 3],
+            last_gravity: [0.0; 3],
+            last_norm: 0.0,
+        };
+
+        // A still robot is told to stand, which is the command a bench can justify: no twist,
+        // no head, nominal stance.
+        let command = Command::default();
+        let last_action = [0.0f32; ACTION_LEN];
+        let mut previous_quat = None;
+
+        let start = Instant::now();
+        let deadline = start + window;
+        while Instant::now() < deadline {
+            let tick = Instant::now();
+
+            let sensors = match io.read() {
+                Ok(sensors) => sensors,
+                Err(e) => {
+                    report.read_failures += 1;
+                    if report.read_failures <= 3 {
+                        eprintln!("read failed: {e}");
+                    }
+                    std::thread::sleep(PERIOD);
+                    continue;
+                }
+            };
+            report.ticks += 1;
+
+            // A held attitude is the decoder doing its job, but it is worth counting: it is the
+            // one degradation the loop above cannot see, because a stale orientation looks
+            // exactly like a still robot.
+            if previous_quat == Some(sensors.imu.quat) {
+                report.stale_ticks += 1;
+            }
+            previous_quat = Some(sensors.imu.quat);
+
+            let observation = Observation::build(
+                &sensors.imu,
+                &sensors.positions,
+                &sensors.velocities,
+                &DEFAULT_POSITION,
+                &last_action,
+                &command,
+            );
+            let slots = observation.as_slice();
+
+            // The two checks this example exists for. Tolerances are f32-sized: the
+            // observation is `[f32; 61]` and the IMU is f64, so the round trip is lossy by
+            // design and comparing exactly would fail on every tick.
+            for i in 0..3 {
+                if (f64::from(slots[i]) - sensors.imu.gyro[i]).abs() > 1e-6 {
+                    report.bad_gyro += 1;
+                }
+                if (f64::from(slots[3 + i]) - sensors.imu.gravity[i]).abs() > 1e-6 {
+                    report.bad_gravity += 1;
+                }
+            }
+            if slots[6..34].iter().any(|v| v.abs() > 1e-6) {
+                report.bad_joints += 1;
+            }
+
+            report.last_gyro = sensors.imu.gyro;
+            report.last_gravity = sensors.imu.gravity;
+            report.last_norm = sensors.imu.quat.iter().map(|c| c * c).sum::<f64>().sqrt();
+
+            if report.ready_after.is_none() && io.imu_ready() {
+                report.ready_after = Some(report.ticks);
+            }
+
+            if report.ticks.is_multiple_of(PRINT_EVERY) {
+                println!(
+                    "tick {:>5}  gyro [{:+.3} {:+.3} {:+.3}]  gravity [{:+.3} {:+.3} {:+.3}]",
+                    report.ticks, slots[0], slots[1], slots[2], slots[3], slots[4], slots[5],
+                );
+            }
+
+            // The policy's own output fed back. On a bench nothing drives it, so it stays
+            // zero — but the observation is built through the real entry point rather than a
+            // shortened copy of it, which is the whole reason this exists.
+            let spent = tick.elapsed();
+            if spent < PERIOD {
+                std::thread::sleep(PERIOD - spent);
+            }
+        }
+        report.seconds = start.elapsed().as_secs_f64();
+        report
+    }
+}
